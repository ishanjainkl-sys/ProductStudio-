generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DEVELOPER
  DESIGNER
  CONTENT
  PM
}

model User {
  id                      String    @id
  email                   String    @unique
  username                String?   @unique
  name                    String?   @default("") // Kept for backward compat
  firstName               String?   @default("")
  lastName                String?   @default("")
  profilePictureUrl       String?
  dateOfBirth             DateTime?
  bio                     String?
  
  // Plan Details
  plan                    String    @default("FREE")
  planStatus              String    @default("ACTIVE")
  planStartDate           DateTime?
  planExpiryDate          DateTime?

  // Flags & Badges
  isVerified              Boolean   @default(false)
  verificationDate        DateTime?

  // Security & Privacy
  twoFactorEnabled        Boolean   @default(false)
  lastLoginAt             DateTime?
  profileVisibility       String    @default("PRIVATE")
  notificationPreferences Json?

  passwordHash            String
  role                    UserRole
  projects                Project[]
  
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Project {
  id                String           @id
  name              String
  description       String?
  owner             User             @relation(fields: [ownerId], references: [id])
  ownerId           String
  templateVersion   TemplateVersion? @relation(fields: [templateVersionId], references: [id])
  templateVersionId String?
  pages             Page[]
  assets            Asset[]
  theme             Theme?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  @@index([ownerId])
  @@index([deletedAt])
}

model Page {
  id              String           @id
  project         Project          @relation(fields: [projectId], references: [id])
  projectId       String
  name            String
  slug            String
  isHome          Boolean          @default(false)
  sortOrder       Int              @default(0)
  contentJson     Json
  seoTitle        String?
  seoDescription  String?
  version         Int              @default(1)
  assetReferences AssetReference[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@unique([projectId, slug])
  @@index([projectId])
}

model Template {
  id          String            @id
  name        String
  category    String?
  description String?
  versions    TemplateVersion[]
  createdAt   DateTime          @default(now())
}

model TemplateVersion {
  id            String         @id
  template      Template       @relation(fields: [templateId], references: [id])
  templateId    String
  versionNumber Int
  pages         TemplatePage[]
  projects      Project[]
  createdAt     DateTime       @default(now())

  @@unique([templateId, versionNumber])
}

model TemplatePage {
  id                String          @id
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id])
  templateVersionId String
  name              String
  slug              String
  isHome            Boolean         @default(false)
  sortOrder         Int             @default(0)
  contentJson       Json
}

model Asset {
  id               String           @id
  project          Project          @relation(fields: [projectId], references: [id])
  projectId        String
  url              String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  originalFilename String
  references       AssetReference[]
  createdAt        DateTime         @default(now())
  deletedAt        DateTime?

  @@index([projectId])
}

model AssetReference {
  id      String @id
  asset   Asset  @relation(fields: [assetId], references: [id])
  assetId String
  page    Page   @relation(fields: [pageId], references: [id])
  pageId  String
  nodeId  String

  @@index([assetId])
  @@index([pageId])
}

model Theme {
  id         String  @id
  project    Project @relation(fields: [projectId], references: [id])
  projectId  String  @unique
  tokensJson Json
}

model RevokedToken {
  id        String   @id
  tokenId   String   @unique
  revokedAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

enum OtpPurpose {
  SIGNUP
  PASSWORD_RESET
}

model EmailOtp {
  id          String     @id
  email       String
  purpose     OtpPurpose
  codeHash    String
  /// Signup stores a temporary passwordHash until OTP is verified.
  payloadJson Json?
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}
